{
  "name": "jess-ide-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/api/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-editor.mjs",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:migrate:built": "node --env-file-if-exists=.env dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/integration.test.ts",
    "test:portal": "node --test remote/security.test.mjs",
    "test:frontend": "node --test remote/state.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:portal && npm run test:frontend && npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fastify/rate-limit": "^11.2.1",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "marked": "^18.1.1",
    "openai": "^7.43.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
