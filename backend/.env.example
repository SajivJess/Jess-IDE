# Application Settings
PROJECT_NAME="Jess Ide Dev Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Bindings
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (JSON array or comma-separated origins)
# For local Flutter development (web, local host, Android emulator 10.0.2.2)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# Database Configuration
# Default local development uses async SQLite.
# For PostgreSQL with asyncpg: "postgresql+asyncpg://postgres:postgres@localhost:5432/jess_dev"
DATABASE_URL="sqlite+aiosqlite:///./jess_dev.db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Security & Authentication
SECRET_KEY="jess_dev_super_secret_jwt_signing_key_min_32_bytes_long_123456"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
