# ==============================================================================
# MuseFlow Configuration Template (.env.example)
# Copy this file to backend/.env and configure your local settings.
# Never commit real credentials or .env files to Git.
# ==============================================================================

# Application & Environment Settings
PROJECT_NAME="MuseFlow Backend"
ENVIRONMENT="development"              # Set to "production" or "staging" for deployment
DEBUG=true                              # Set to false in production to disable OpenAPI/docs exposure
API_V1_STR="/api/v1"

# Server Host & Bindings
HOST="127.0.0.1"                        # Bind to 127.0.0.1 for local USB ADB; never bind 0.0.0.0 on untrusted networks
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080","http://10.0.2.2:8000"]

# Database Persistence
# Default uses asynchronous SQLite for zero-configuration local execution.
# For production PostgreSQL: "postgresql+asyncpg://user:password@localhost:5432/museflow"
DATABASE_URL="sqlite+aiosqlite:///./jess_dev.db"

# Security & Authentication Boundary
# CRITICAL: In production or staging, you MUST provide a unique, random 32+ character secret key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The backend will refuse startup in production if the default placeholder is detected.
SECRET_KEY="jess_dev_super_secret_jwt_signing_key_min_32_bytes_long_123456"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Three-Model Meta Architecture (Meta Global AI Developer Hackathon)
# MODEL_API_KEY is stored EXCLUSIVELY on the server — never commit, log, or send to mobile devices.
MODEL_API_KEY=""                        # Meta Model API Key. Leave empty for deterministic offline simulation mode.
AGENT_PROVIDER="meta"                   # "meta" (calls Meta Model API) or "simulated" (deterministic offline mock)
META_MODEL_BASE_URL="https://api.meta.ai/v1"
META_MODEL_ID="muse-spark-1.3"                  # Primary coding agent: reasoning, tool use, test verification
META_VOICE_MODEL_ID="muse-voice-transcribe-1.0" # Push-to-talk voice transcription
META_IMAGE_MODEL_ID="muse-image-1.0"            # AI UI suggestion screen mockup generation

# Public Tunnel / Remote Preview (Optional)
PUBLIC_TUNNEL_URL=
