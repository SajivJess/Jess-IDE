# Copy to .env and replace both placeholders. Never commit .env.
NODE_ENV=development
AUTH_MODE=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEV_AUTH_TOKEN=REPLACE_WITH_RANDOM_DEVELOPMENT_TOKEN
DATABASE_URL=postgresql://jess:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/jess
PORT=3000
# Optional worker defaults:
WORKER_POLL_MS=500
WORKER_LEASE_MS=15000
FAKE_AGENT_STEP_MS=250
# Integration tests use a separate, disposable database. Never use production data.
# TEST_DATABASE_URL=postgresql://jess:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/jess_test
# REQUIRE_DATABASE_TESTS=1

# Default remains the deterministic simulator. For local Antigravity CLI work,
# authenticate using scripts/antigravity.ps1 and read docs/antigravity-cli.md.
AGENT_PROVIDER=fake
# ANTIGRAVITY_CLI_PATH=E:/tools/antigravity-cli/agy.exe
# AGENT_GIT_PATH=E:/tools/git/cmd/git.exe
# AGENT_NODE_PATH=E:/tools/node-v24.22.0-win-x64/node.exe
# AGENT_NPM_CLI_PATH=E:/tools/node-v24.22.0-win-x64/node_modules/npm/bin/npm-cli.js
# AGENT_SOURCE_REPO=E:/Jess-IDE
# AGENT_WORKSPACE_ROOT=E:/local-data/jess/workspaces
# AGENT_PROFILE=E:/local-data/antigravity-home
# AGENT_TIMEOUT_MS=600000

# ─── Meta Model API adapter ────────────────────────────────────────────────────
# Set AGENT_PROVIDER=meta to use the real Meta-powered coding agent.
# MODEL_API_KEY is server-side only — never commit, log, or send to the browser.
# Run scripts/check-meta-models.mjs first to confirm META_MODEL_ID is available.
# AGENT_PROVIDER=meta
# MODEL_API_KEY=REPLACE_WITH_META_API_KEY
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# META_MODEL_ID=REPLACE_AFTER_RUNNING_check-meta-models
# META_MODEL_TIMEOUT_MS=120000
# META_MODEL_MAX_RETRIES=3
# META_MODEL_MAX_OUTPUT_TOKENS=4096
# META_AGENT_MAX_TOOL_ITERATIONS=20
# META_AGENT_MAX_REPAIR_ATTEMPTS=3
# META_AGENT_WORKSPACE_ROOT=E:/local-data/jess/meta-workspaces
# META_AGENT_GIT_PATH=E:/tools/git/cmd/git.exe
# META_AGENT_NODE_PATH=E:/tools/node-v24.22.0-win-x64/node.exe
# META_AGENT_SOURCE_REPO=E:/Jess-IDE
# Live API smoke test (never run in CI):
# META_LIVE_SMOKE=1
